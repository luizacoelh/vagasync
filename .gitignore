# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
dev.db
*.db
dev.db-journal
prisma/dev.db

# Maestri: o papel (role.json) é versionado; o resto da pasta de cada papel
# é gerado na máquina (AGENTS.md/CLAUDE.md com caminho absoluto, permissões
# e servidores MCP desta sessão em .claude/)
.maestri/roles/*/*
!.maestri/roles/*/role.json

# claude code (local) e backups do banco
.claude/settings.local.json
/backups/
