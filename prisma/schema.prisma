generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Modelos de autenticação (Auth.js / NextAuth v5 + @auth/prisma-adapter)
// Nomes e campos seguem exatamente o schema oficial esperado pelo
// PrismaAdapter — não renomeie nada aqui, o adapter espera esses nomes.
// ---------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  jobs     Job[]
  profile  UserProfile?
  aiUsage  AiUsage[]

  // limites de uso da API do Gemini, para evitar abuso (ver lib/rateLimit.ts)
  geminiCallCount   Int      @default(0)
  geminiCallResetAt DateTime @default(now())

  // dailyAiLimitOverride nulo = usa o limite global de AppSettings.
  // Serve tanto para dar um limite maior a uma conta específica (inclusive a
  // sua) quanto para restringir uma conta problemática, sem precisar de
  // deploy — ver /admin.
  dailyAiLimitOverride Int?
  isAdmin              Boolean @default(false)

  createdAt DateTime @default(now())
}

// Configuração global do app, editável via /admin sem precisar de deploy.
// Linha única (singleton) — sempre lida/criada com id fixo "singleton", ver
// lib/appSettings.ts.
model AppSettings {
  id                   String   @id @default("singleton")
  dailyAiLimit         Int      @default(20)
  ipHourlyLimit        Int      @default(30)
  maxDescriptionLength Int      @default(8000)
  updatedAt            DateTime @updatedAt
}

// Perfil profissional do usuário — separado de User (que é gerenciado pelo
// PrismaAdapter) de propósito, pra não misturar dados de autenticação com
// dados de produto. Onboarding: usuário sem UserProfile é redirecionado para
// /perfil no primeiro acesso ao Dashboard (ver app/page.tsx).
model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal         String?  // objetivo profissional
  interestArea String?  // área de interesse
  experience   ExperienceLevel @default(NAO_INFORMADO)
  skills       String   @default("[]") // JSON stringificado (array) — mesma decisão de lib/json.ts

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ExperienceLevel {
  ESTAGIO
  JUNIOR
  PLENO
  SENIOR
  NAO_INFORMADO
}

// Registro de cada chamada à API do Gemini, por usuário. Não tem painel de
// visualização ainda (fora do escopo desta sprint) — existe pra permitir
// isso no futuro sem precisar mudar o schema de novo.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // ex: "analyze_job"
  tokens    Int?     // aproximado; a API do Gemini nem sempre devolve contagem exata
  ip        String?  // usado pelo rate limit por IP, ver lib/ipRateLimit.ts
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([ip, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Usada hoje para o fluxo OAuth (Google/GitHub) internamente pelo adapter, e
// preparada para o futuro Magic Link por e-mail (provider "Email"/Resend) —
// ver comentário em auth.ts.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum JobStatus {
  MONITORADA  // vaga coletada automaticamente (n8n) — ainda não candidatada
  APLICADA
  ENTREVISTA
  REPROVADA
  OFERTA
}

enum JobLocation {
  REMOTO
  HIBRIDO
  PRESENCIAL
  NAO_INFORMADO
}

model Job {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  company      String
  title        String
  description  String
  status       JobStatus   @default(APLICADA)

  url          String?     // link original da vaga, se houver
  location     JobLocation @default(NAO_INFORMADO)
  salary       String?     // texto livre — ex: "R$ 2.000" ou "Não informado"
  appliedAt    DateTime    @default(now()) // data em que a candidatura foi feita (editável, separada de createdAt)

  summary      String?
  requirements String?     // JSON stringificado (array) — decisão temporária do MVP, ver README
  technologies String?     // JSON stringificado (array)
  questions    String?     // JSON stringificado (array)
  checklist    String?     // JSON stringificado (array de { text, done })

  createdAt    DateTime    @default(now())

  @@index([userId])
}