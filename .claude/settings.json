{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run check:turso*)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git pull --ff-only origin main)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin --delete feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin --delete fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin --delete chore/*)",
      "Bash(node scripts/github-pr.mjs *)"
    ],
    "ask": [
      "Bash(npm run migrate:turso*)",
      "Bash(node scripts/github-pr.mjs * --turso-aplicado*)",
      "Bash(node scripts/apply-turso-migrations.mjs*)",
      "Bash(node scripts/set-admin.mjs*)",
      "Bash(npx prisma migrate*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./backups/**)",
      "Read(./**/*.db)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(node scripts/fix-turso-job-table.mjs*)",
      "Bash(node scripts/sync-turso-schema.mjs*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:*)",
      "Bash(git push *+*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(git pull *--upload-pack*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git add -f*)",
      "Bash(git add * -f*)",
      "Bash(git add --force*)",
      "Bash(git add * --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)"
    ]
  }
}
