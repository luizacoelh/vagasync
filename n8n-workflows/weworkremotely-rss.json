      ],
      "alwaysOutputData": false,
      "retryOnFail": false,
      "credentials": {
        "httpHeaderAuth": {
          "id": "4hKzRl0IGwT4zRJf",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "check-success",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
