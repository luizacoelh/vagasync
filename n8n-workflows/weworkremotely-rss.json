            "version": 1
          }
        },
        "options": {}
      },
      "id": "faa9b2a6-bfa9-43a1-8c08-28ad801f7f9e",
      "name": "Vaga criada?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        1328,
